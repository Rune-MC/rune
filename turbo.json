{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "target/release/**",
        "build/libs/**",
        "dist/**"
      ],
      "cache": true
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": [],
      "cache": true
    },
    "release": {
      "dependsOn": ["build"],
      "outputs": [
        "dist/**",
        "release/**"
      ],
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
